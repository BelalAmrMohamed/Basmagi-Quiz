+
+// ---------- binary analysis ----------
+function binary(v: V, fn: string): T {
+  const t = T_(v, fn);
+  if (t.cls === 'char' || t.dims.length > 2) err(`Error using ${fn}: Expected input number 1, BW, to be a 2-D logical or numeric image.`);
+  return t;
