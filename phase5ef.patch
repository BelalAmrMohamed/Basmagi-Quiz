diff --git a/runtimes/matlab/src/help.ts b/runtimes/matlab/src/help.ts
index e364be7..c9f12d4 100644
--- a/runtimes/matlab/src/help.ts
+++ b/runtimes/matlab/src/help.ts
@@ -19,6 +19,8 @@ export const MATLAB_HELP: NonNullable<Engine['help']> = {
     ["Intensity, thresholds and metrics", "imadjust, stretchlim, graythresh, imbinarize, immultiply, imdivide, imlincomb, mean2, std2, corr2, entropy, immse, psnr, ssim, imnoise. Results keep the class of the image (rounded and saturated for integers). Differences from MATLAB: imbinarize supports only the global (Otsu) method and a numeric level; graythresh and entropy pool all pixels of N-D input and convert to 8 bits first; imadjust and stretchlim take 2-D or 3-D input and do not accept logical images in imadjust; ssim uses replicated borders and returns the mean over all pixels and channels; imnoise does not support 'poisson' or 'localvar', and its random numbers differ from MATLAB's for the same rng seed.", "الشدّة والعتبات والمقاييس: imadjust وstretchlim وgraythresh وimbinarize وimmultiply وimdivide وimlincomb وmean2 وstd2 وcorr2 وentropy وimmse وpsnr وssim وimnoise. تحافظ النتائج على صنف الصورة (تقريب وإشباع للأعداد الصحيحة). الاختلافات عن MATLAB: تدعم imbinarize الطريقة العامة (Otsu) وعتبة رقمية فقط؛ تجمع graythresh وentropy كل بكسلات المدخل متعدد الأبعاد وتحوّله إلى 8 بت أولاً؛ تقبل imadjust وstretchlim مدخلات ثنائية أو ثلاثية الأبعاد ولا تقبل imadjust الصور المنطقية؛ تستخدم ssim حدوداً مكررة وتعيد المتوسط على كل البكسلات والقنوات؛ لا تدعم imnoise النوعين 'poisson' و'localvar' وأرقامها العشوائية تختلف عن MATLAB لنفس قيمة rng."],
     ["Edge detection", "edge(I, method, thresh): sobel (default), prewitt, roberts, log and canny; [BW,thresh] = edge(...) also returns the threshold. Differences from MATLAB: borders are replicated and the outermost pixel ring is never marked; gradient kernels are scaled by 1/8 (sobel), 1/6 (prewitt) and none (roberts); the default threshold is the documented estimator (4, 4 and 6 times the mean squared gradient for sobel, prewitt and roberts; 0.75 times the mean |LoG| for log; the 64-bin gradient histogram with 70% non-edge pixels for canny), so results can differ from MATLAB on real images; two equal neighboring maxima are thinned to the second one; roberts and canny thin by non-maximum suppression along four quantized directions and canny skips the final bwmorph thinning step; 'zerocross' is not supported.", "الحواف: edge(I, method, thresh) بالطرق sobel (الافتراضية) وprewitt وroberts وlog وcanny؛ وتعيد [BW,thresh] = edge(...) العتبة المستخدمة أيضاً. الاختلافات عن MATLAB: تُكرَّر الحدود ولا تُعلَّم حلقة البكسلات الخارجية أبداً؛ تُقسَم نوى التدرج على 8 (sobel) و6 (prewitt) ولا تُقسَم في roberts؛ العتبة الافتراضية هي المقدّر الموثّق (4 و4 و6 أضعاف متوسط مربع التدرج لـ sobel وprewitt وroberts؛ و0.75 من متوسط |LoG| لـ log؛ ومدرج التدرج بـ64 خانة مع 70% من البكسلات غير الحواف لـ canny) لذلك قد تختلف النتائج عن MATLAB على الصور الحقيقية؛ عند تساوي قمتين متجاورتين يُحتفظ بالثانية؛ تُرقِّق roberts وcanny بقمع غير الأعظم على أربعة اتجاهات مكمّاة وتتخطى canny خطوة bwmorph الأخيرة؛ 'zerocross' غير مدعوم."],
     ["Resize, rotate, translate", "imresize (nearest, bilinear, bicubic), imrotate (any angle, 'loose' or 'crop'), imtranslate. Differences from MATLAB: imresize supports only the nearest, bilinear and bicubic methods and the options Antialiasing, OutputSize and Scale (no indexed images, Colormap or Dither); imrotate and imtranslate treat the image as 0.5 pixel larger on each side and use the edge value for interpolation neighbors beyond the border, so the outermost pixels are not blended with the fill value; imrotate resamples by inverse mapping with the loose box computed as ceil of the exact rotated extent, so the output size can differ by one pixel from MATLAB for some angles; imtranslate takes [tx ty] only (no third element) and imrotate's 'loose' box with a multiple of 90 degrees is exact (no resampling).", "تغيير الحجم والتدوير والإزاحة: imresize (nearest وbilinear وbicubic) وimrotate (أي زاوية مع 'loose' أو 'crop') وimtranslate. الاختلافات عن MATLAB: تدعم imresize الطرق nearest وbilinear وbicubic فقط والخيارات Antialiasing وOutputSize وScale (دون الصور المفهرسة أو Colormap أو Dither)؛ تعتبر imrotate وimtranslate الصورة أكبر بنصف بكسل من كل جانب وتستخدم قيمة الحافة لجيران الاستيفاء خارج الحدود فلا تُمزج البكسلات الخارجية مع قيمة التعبئة؛ تعيد imrotate العينة بالتحويل العكسي ويُحسب الصندوق 'loose' بسقف الامتداد المدوَّر الدقيق فقد يختلف حجم الناتج بمقدار بكسل عن MATLAB لبعض الزوايا؛ تأخذ imtranslate القيمتين [tx ty] فقط، وتدوير مضاعفات 90 درجة مع 'loose' دقيق دون إعادة عينة."],
+    ["Color conversions and indexed images", "hsv2rgb, ycbcr2rgb, ntsc2rgb, rgb2lab, lab2rgb, rgb2ind, ind2rgb, gray2ind, ind2gray. imshow(X, map), image and ind2rgb treat double indices as 1-based and integer classes as 0-based, as in MATLAB. Differences from MATLAB: rgb2lab and lab2rgb support only the sRGB color space with the D65 white point [0.95047 1 1.08883], so values can differ from MATLAB in the fourth decimal; hsv2rgb and ntsc2rgb take double or single only; rgb2ind never dithers, quantizes with median cut instead of minimum variance, and treats a tolerance as uniform cubes whose color is the mean of their pixels; ind2gray returns the class of X.", "تحويلات الألوان والصور المفهرسة: hsv2rgb وycbcr2rgb وntsc2rgb وrgb2lab وlab2rgb وrgb2ind وind2rgb وgray2ind وind2gray. تعامل imshow(X, map) وimage وind2rgb فهارس double على أنها تبدأ من 1 والأصناف الصحيحة من 0 كما في MATLAB. الاختلافات عن MATLAB: تدعم rgb2lab وlab2rgb فضاء sRGB بالنقطة البيضاء D65 [0.95047 1 1.08883] فقط فقد تختلف القيم في الخانة العشرية الرابعة؛ تقبل hsv2rgb وntsc2rgb الصنفين double وsingle فقط؛ لا تطبّق rgb2ind أي تمويه (dithering) وتستخدم القطع بالوسيط (median cut) بدل التباين الأدنى وتعامل العتبة كمكعبات منتظمة لونها متوسط بكسلاتها؛ تعيد ind2gray صنف X."],
+    ["Morphology and binary analysis", "strel (square, rectangle, diamond, disk, line, arbitrary), getnhood, imerode, imdilate, imopen, imclose, imfill(I,'holes'), bwlabel, bwareaopen, regionprops(L,'Area','Centroid','BoundingBox'). Differences from MATLAB: strel returns a plain struct with Neighborhood and Height; strel('disk', r) with the default n = 4 is an octagon-like approximation (pixels with x^2 + y^2 <= r^2 + r - 1) that can differ from MATLAB's decomposed disk by a few pixels, and n = 0 gives the exact circle; strel('line') places the pixels by rounding along the major axis; no 'pair', 'periodicline', 'octagon' or 'sphere' shapes and no decomposition; imerode and imdilate on double images give -Inf or Inf where the whole window lies outside the image; imfill supports only 'holes' (4-connected background), with no interactive or seed forms; regionprops supports only Area, Centroid and BoundingBox, and a numeric (non-logical) input is taken as a label matrix; bwperim and bwmorph are not available.", "المورفولوجيا والتحليل الثنائي: strel (square وrectangle وdiamond وdisk وline وarbitrary) وgetnhood وimerode وimdilate وimopen وimclose وimfill(I,'holes') وbwlabel وbwareaopen وregionprops(L,'Area','Centroid','BoundingBox'). الاختلافات عن MATLAB: تعيد strel بنية عادية فيها Neighborhood وHeight؛ تقريب strel('disk', r) بالقيمة الافتراضية n = 4 شبه ثماني الأضلاع (البكسلات التي x^2 + y^2 <= r^2 + r - 1) وقد يختلف عن القرص المفكَّك في MATLAB ببضعة بكسلات وn = 0 يعطي الدائرة الدقيقة؛ يضع strel('line') البكسلات بالتقريب على المحور الأكبر؛ لا أشكال 'pair' أو 'periodicline' أو 'octagon' أو 'sphere' ولا تفكيك؛ تعطي imerode وimdilate على صور double القيمة -Inf أو Inf حيث تقع النافذة كلها خارج الصورة؛ تدعم imfill الخيار 'holes' فقط (خلفية مترابطة بأربعة جيران) دون الصيغ التفاعلية؛ تدعم regionprops الخصائص Area وCentroid وBoundingBox فقط ويُعد المدخل الرقمي (غير المنطقي) مصفوفة تسميات؛ لا تتوفر bwperim وbwmorph."],
     ["Array operations", "size, numel, length, reshape, repmat, indexing, ranges, and logical masks.", "عمليات المصفوفات: size وnumel وlength وreshape وrepmat والفهرسة والنطاقات."],
     ["Math and display", "sum, mean, max, min, abs, sqrt, disp, fprintf, sprintf, and error.", "الحساب والعرض: sum وmean وmax وmin وabs وsqrt وdisp وfprintf وsprintf وerror."],
     ["Math and arrays (extended)", "median, mode, std, var, diff, cumprod, norm, dot, cross, det, inv, rank, eye, magic, diag, tril, triu, meshgrid, kron, permute, circshift, flip, rot90, unique, histc, accumarray, ismember, isequal, bitand, bitor, bitxor, bitshift, intmax, intmin, rng, randn.", "رياضيات ومصفوفات موسعة: median وmode وstd وvar وdiff وcumprod وnorm وdot وcross وdet وinv وrank وeye وmagic وdiag وtril وtriu وmeshgrid وkron وpermute وcircshift وflip وrot90 وunique وhistc وaccumarray وismember وisequal وbitand وbitor وbitxor وbitshift وintmax وintmin وrng وrandn."],
