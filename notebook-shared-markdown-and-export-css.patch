 /* ══════════════════════════════════════════════════════════════════════════════
-   MODERN TERMINAL CODE BLOCKS + INDESTRUCTIBLE 3-COLUMN HEADER
+   CODE BLOCKS — same look as the AI Agent rich input (rich-input.css)
+   Mirrored from src/styles/markdown.css. Exports are dark by default (each
+   consumer's :root block defines the --color-* tokens); [data-theme="light"]
+   switches the syntax palette. Syntax colours mirror the rich input's hljs
+   palette (GitHub light / dark).
    ══════════════════════════════════════════════════════════════════════════════ */
 
 .code-block-wrapper {
+  --mdcb-fg: var(--color-text-primary, #e6e6e6);
+  --mdcb-muted: var(--color-text-secondary, #aaa);
+  --mdcb-border: var(--color-border, #333);
+  --mdcb-card: var(--color-surface, var(--color-background-secondary, #1e1e1e));
+  --mdcb-bg: color-mix(in srgb, var(--color-background-secondary, #1e1e1e) 70%, var(--mdcb-card));
+  --mdcb-hover: color-mix(in srgb, var(--mdcb-fg) 10%, transparent);
+
+  --mdcb-comment: #7d8590;
+  --mdcb-kw: #ff7b72;
+  --mdcb-str: #a5d6ff;
+  --mdcb-num: #79c0ff;
+  --mdcb-fn: #d2a8ff;
+  --mdcb-type: #ffa657;
+  --mdcb-attr: #7ee787;
+
   display: grid;
   grid-template-columns: auto 1fr auto auto;
   grid-template-rows: auto 1fr;
-  margin: 20px 0;
+  margin: 16px 0;
   direction: ltr !important;
-  border-radius: 10px;
-  background: #121214;
-  border: 1px solid #2d2d34;
-  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
+  text-align: left;
+  border-radius: 14px;
+  background: var(--mdcb-bg);
+  border: 1px solid var(--mdcb-border);
+  color: var(--mdcb-fg);
   position: relative;
   max-height: 500px;
   overflow: hidden;
 }
 
