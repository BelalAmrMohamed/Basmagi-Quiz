+      jsonb_build_object('kind', 'lesson', 'metric', 'views', 'value', v_count, 'itemTitle', v_title),
+      NULL, 'milestone:lesson:' || p_lesson_id || ':' || v_count);
+  END IF;
+END;
+$$;
