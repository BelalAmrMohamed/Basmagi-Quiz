{"lesson":{"title":"طريقة السمبلكس","lang":"ar","type":"math"},
"scenes":[
{"id":"s1","items":[
 {"k":"title","md":"طريقة السمبلكس (Simplex Method)"},
 {"k":"text","md":"في مسألة التعظيم (Maximization) نكتب دالة الهدف $Z = 3x_1 + 5x_2$ مع القيد $2x_1 + x_2 \\le 8$"},
 {"k":"text","md":"ثم نضيف متغيرات مساعدة (Slack Variables) لتحويل المتباينة إلى معادلة"},
 {"k":"math","tex":"2x_1 + x_2 + S_1 = 8"}]},
{"id":"s2","items":[
 {"k":"title","md":"قانون الجذور"},
 {"k":"text","md":"لحل المعادلة التربيعية نستخدم القانون الآتي:"},
 {"k":"math","tex":"x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"},
 {"k":"text","md":"حيث الـ discriminant يساوي $b^2 - 4ac$"}]},
{"id":"s3","items":[
 {"k":"title","md":"التفاضل والتكامل"},
 {"k":"text","md":"مشتقة الدالة $f(x) = x^2$ هي:"},
 {"k":"math","tex":"\\frac{d}{dx}x^2 = 2x"},
 {"k":"text","md":"والتكامل المحدد:"},
 {"k":"math","tex":"\\int_0^1 x\\,dx = \\frac{1}{2}"}]},
{"id":"s4","items":[
 {"k":"title","md":"حل خطوة بخطوة"},
 {"k":"text","md":"نحل المعادلة خطوة بخطوة:"},
 {"k":"math","tex":"2x + 3 = 11"},{"k":"math","tex":"2x = 8"},{"k":"math","tex":"x = 4"},
 {"k":"text","md":"إذن قيمة الـ variable تساوي 4"}]},
{"id":"s5","items":[
 {"k":"title","md":"قوانين التحديث"},
 {"k":"text","md":"قانون الصف الجديد:"},
 {"k":"line","md":"New Z = Old Z - (Pivot Key Coefficient * New Entering Row)"},
 {"k":"text","md":"أي أن الـ Pivot Key يُستخدم لتحديث صف Z"}]},
{"id":"s6","items":[
 {"k":"title","md":"الجدول الأول للسمبلكس"},
 {"k":"text","md":"نكوّن الجدول الأول من القيود ودالة الهدف:"},
 {"k":"table","rows":[["Basic","x1","x2","S1","RHS"],["S1","2","1","1","8"],["S2","1","3","0","9"],["Z","-3","-5","0","0"]],"say":"الجدول الأول يحتوي على Basic variables وعمود الـ RHS وصف Z"},
 {"k":"list","items":["نبحث في صف Z عن أقل قيمة سالبة","هذا هو عمود الارتكاز (Pivot Column)","نقسم الـ RHS على عمود الارتكاز لتحديد صف الارتكاز"]},
 {"k":"math","tex":"\\text{Ratio} = \\frac{RHS}{\\text{Pivot Column}}"},
 {"k":"text","md":"أقل نسبة موجبة تحدد صف الارتكاز (Pivot Row)"}]}
]}
