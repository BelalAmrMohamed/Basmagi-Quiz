+
+  const hoverCapable =
+    window.matchMedia && window.matchMedia("(hover: hover) and (pointer: fine)").matches;
+  if (hoverCapable) {
+    wrap.addEventListener("mouseenter", () => setOpen(true));
+    wrap.addEventListener("mouseleave", () => setOpen(false));
+  }
