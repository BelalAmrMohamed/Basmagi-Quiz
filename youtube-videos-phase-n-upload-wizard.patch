+  const confirmed = await _confirmTyped({
+    message:
+      "سيتم حذف كل محتواك ومجلداتك نهائياً ولا يمكن التراجع عن هذا الإجراء.\nللمتابعة، اضغط \"نعم\" ثم اكتب العبارة المطلوبة في الخطوة التالية.",
+    confirmPhrase: "حذف الكل",
