+  const destinationNodes = ["folder", "quiz", "lesson", "notebook", "youtube"].includes(itemType)
+    ? nodes.filter((node) =>
+      node.prefix === "course"
+        ? node.raw.id === destinationCourseId
+        : node.raw.course_id === destinationCourseId)
+    : nodes;
