+  trigger.onclick = (e) => {
+    e.stopPropagation(); // keep the menu open (the document handler would close it)
+    setOpen(!isOpen());
+  };
+  trigger.onkeydown = (e) => {
+    if (e.key === "Enter" || e.key === " " || e.key === "ArrowLeft") {
