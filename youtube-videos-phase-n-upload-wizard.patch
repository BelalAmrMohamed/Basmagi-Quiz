+          name: seg,
+          depth,
+          parentKey,
+          quizFiles: [],
+          childKeys: new Set(),
+        });
+        if (depth === 0) rootDirKeys.add(pathSoFar);
+        if (parentKey) dirNodes.get(parentKey).childKeys.add(pathSoFar);
+      }
+      parentKey = pathSoFar;
+    });
