+  if (itemType === "course") {
+    // Courses are top-level only — nowhere to move them to (mirrors the
+    // localStorage lone-course guard in createLocalUserContentMoveSource).
+    showNotification(
+      "لا يمكن النقل",
+      "المواد تبقى في المستوى الرئيسي دائماً ولا يمكن نقلها.",
+      "warning",
+    );
+    return;
+  }
+
+  const nodes = await fetchSharedDestinationNodes();
+  if (!nodes) {
+    showNotification(
+      "خطأ",
+      "تعذّر تحميل قائمة الوجهات. حاول مرة أخرى.",
+      "error",
+    );
+    return;
+  }
+
+  const destinationCourseId = itemType === "folder" ? item.course_id : item.courseId;
+  if (["folder", "quiz", "lesson", "notebook", "youtube"].includes(itemType) && !destinationCourseId) {
+    showNotification(
+      "تعذّر النقل",
+      "لم يتم العثور على المادة التي ينتمي إليها هذا العنصر. حدّث الصفحة وحاول مرة أخرى.",
+      "error",
+    );
+    return;
+  }
