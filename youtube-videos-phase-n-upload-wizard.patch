+/**
+ * Renders the user's folder/course tree as an indented plain-text list by
+ * title (root "محتواي الرئيسية" first, then each folder/course nested
+ * under its parent) for the AI agent's system-context — this is the only
+ * way the model can resolve create_folder's parentFolder or move_item's
+ * itemName/destinationFolder to a real location, since (like every other
+ * tool on this page) it only ever sees titles, never internal ids.
+ * @param {object[]} userContent
+ * @returns {string}
+ */
+function buildFolderTreeContextPrompt(userContent) {
+  // Videos are leaves: included as compact title+kind records, not as containers.
+  const nodes = userContent.filter(
+    (q) => q.meta?.type === "folder" || q.meta?.type === "course" || q.meta?.type === "youtube_video" || q.meta?.type === "youtube_playlist",
+  );
+  const lines = ["هيكل المجلدات والمواد الحالي للمستخدم:", "- محتواي الرئيسية (المستوى الرئيسي)"];
+
+  function appendChildren(parentId, depth) {
+    nodes
+      .filter((n) => (n.meta?.parentId || null) === parentId)
+      .forEach((n) => {
+        const nid = n.id || n.meta?.id;
+        const kind = n.meta?.type === "course"
+          ? "مادة"
+          : n.meta?.type === "youtube_video"
+            ? "فيديو"
+            : n.meta?.type === "youtube_playlist"
+              ? "قائمة تشغيل"
+              : "مجلد";
+        lines.push(`${"  ".repeat(depth)}- ${n.meta?.title || ""} (${kind})`);
+        appendChildren(nid, depth + 1);
+      });
+  }
+  appendChildren(null, 1);
+
+  return lines.join("\n");
+}
