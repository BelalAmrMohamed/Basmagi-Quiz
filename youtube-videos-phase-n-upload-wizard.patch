+  const itemType = resolveItemType(item);
+  const itemId = resolveItemId(item);
+  if (!itemType || !itemId) {
+    showNotification("تعذّر النقل", "تعذّر تحديد المجلد أو العنصر المطلوب. حدّث الصفحة وحاول مرة أخرى.", "error");
+    return;
+  }
