-      .catch(() => showNotification(`تعذّر النسخ تلقائيًا، انسخ الرابط يدويًا: ${url}`, "warning"));
-  } else {
-    showNotification(`تعذّر النسخ تلقائيًا، انسخ الرابط يدويًا: ${url}`, "warning");
-  }
-}
