{
  "name": "examination-platform",
  "version": "6.0.10",
  "description": "Vanilla JS examination platform with quiz creation and export features",
  "type": "module",
  "scripts": {
    "sync:quizzes": "node scripts/sync-quizzes.js",
    "sync:quizzes:clean": "node scripts/sync-quizzes.js --delete-synced",
    "dev": "npx http-server public -p 8080 -o",
    "vercel": "vercel dev",
    "generate-manifest": "node scripts/generate-quiz-manifest.js",
    "map-project": "node scripts/map.js"
  },
  "keywords": [
    "examination",
    "quiz",
    "education",
    "vanilla-js"
  ],
  "author": "Belal Amr Mohamed",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.81.1",
    "@vercel/og": "^0.11.1",
    "jsonwebtoken": "^9.0.3"
  }
}
