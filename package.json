{
  "name": "basamgi-quiz",
  "version": "8.3.4",
  "description": "Vanilla JS examination platform with quiz creation and export features",
  "type": "module",
  "scripts": {
    "seo:check": "node scripts/seo-check.mjs",
    "sidebar:build": "node scripts/build-sidebar.mjs",
    "sidebar:check": "node scripts/build-sidebar.mjs --check",
    "sidebar:test": "node --test tests/sidebar-drift.test.js",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "docs:chapters": "node scripts/build-docs.mjs --chapters how-to-connect-mcp",
    "og:test": "node --test tests/og-render.test.js",
    "test:ai-agent": "node --test tests/ai-agent-*.test.js tests/agent-loop.test.js tests/context-trim.test.js tests/turn-runner.test.js tests/ai-agent-undo.test.js tests/ai-agent-schema-parity.test.js",
    "og:snapshot": "node scripts/og-snapshot.mjs",
    "sync:mcp": "node scripts/sync-mcp-rules.js",
    "dev:vercel": "node scripts/dev-vercel.mjs",
    "vercel": "vercel dev --listen 8080",
    "map": "node scripts/map.js",
    "commit": "node scripts/commit.js",
    "release": "node scripts/release.js",
    "zip": "node scripts/commit.js && git archive --format=zip --output=basmagi.zip HEAD && echo basmagi.zip is ready",
    "push": "node scripts/push-production.mjs",
    "push:all": "npm run zip && git push && npm run push",
    "push:tags": "git push --tags",
    "revert": "git reset --soft HEAD~1",
    "patch": "git apply --ignore-whitespace ",
    "build:runtimes": "npm ci --prefix runtimes --cache node_modules/.cache/npm && npm run build --prefix runtimes",
    "build:cpp-runtime": "npm run build:runtimes",
    "test:runtimes": "npm test --prefix runtimes",
    "typecheck:runtimes": "npm run typecheck --prefix runtimes",
    "typecheck:cpp": "npm run typecheck:runtimes",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "node scripts/build-web.mjs --watch",
    "build:edge": "node scripts/build-edge-functions.mjs",
    "dist:check": "node scripts/build-web.mjs && git diff --exit-code --stat -- public/dist || (echo \"public/dist is stale: commit the rebuilt files\" && exit 1)"
  },
  "keywords": [
    "examination",
    "quiz",
    "education",
    "vanilla-js"
  ],
  "author": "Belal Amr Mohamed",
  "license": "MIT",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "http-server": "^14.1.1",
    "wait-on": "^9.1.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.81.1",
    "@vercel/og": "^0.11.1",
    "formidable": "^3.5.4",
    "ignore": "^7.0.8",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.2",
    "pdfkit": "^0.20.2",
    "upng-js": "2.1.0"
  }
}