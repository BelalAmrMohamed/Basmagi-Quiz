{
  "name": "basamgi-quiz",
  "version": "8.3.0",
  "description": "Vanilla JS examination platform with quiz creation and export features",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:vercel",
    "dev:vercel": "npx vercel dev --local --listen 8080",
    "dev:static": "npx http-server public -p 8080 -o -c-1",
    "vercel": "vercel dev",
    "map": "node scripts/map.js",
    "commit": "git add -A && git commit -am",
    "zip": "git archive --format=zip --output=basmagi-quiz.zip HEAD"
  },
  "keywords": [
    "examination",
    "quiz",
    "education",
    "vanilla-js"
  ],
  "author": "Belal Amr Mohamed",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.81.1",
    "@vercel/og": "^0.11.1",
    "formidable": "^3.5.4",
    "ignore": "^7.0.8",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.2"
  }
}