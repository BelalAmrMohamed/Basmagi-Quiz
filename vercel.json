{
  "buildCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/assets/images/:file*",
      "has": [{ "type": "header", "key": "host", "value": "localhost(.*)" }],
      "destination": "/api/local-asset?file=assets/images/:file*"
    },
    {
      "source": "/data/quizzes/:file*",
      "has": [{ "type": "header", "key": "host", "value": "localhost(.*)" }],
      "destination": "/api/local-asset?file=data/quizzes/:file*"
    },
    { "source": "/q/:id", "destination": "/api/render-quiz?id=:id" }
  ]
}