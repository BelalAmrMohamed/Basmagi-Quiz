{
  "buildCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/sign-in.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/sign-in",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/log-in.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-dynamic.xml",
      "destination": "/api/seo?type=sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/seo?type=feed&format=rss"
    },
    {
      "source": "/feed.json",
      "destination": "/api/seo?type=feed&format=json"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/seo?type=llms-full"
    },
    {
      "source": "/:key([a-f0-9]{32}).txt",
      "destination": "/api/seo?type=indexnow-key&key=:key"
    },
    {
      "source": "/@:handle",
      "destination": "/api/render-profile?handle=:handle"
    },
    {
      "source": "/quiz/:id",
      "destination": "/api/render-quiz?id=:id"
    },
    {
      "source": "/q/:id",
      "destination": "/api/render-quiz?id=:id"
    },
    {
      "source": "/course/:full(.*)",
      "destination": "/api/render-course?full=:full"
    },
    {
      "source": "/api/admin-control",
      "destination": "/api/admin"
    },
    {
      "source": "/api/admin-stats",
      "destination": "/api/admin"
    },
    {
      "source": "/api/user-profile/identify",
      "destination": "/api/user-profile?action=identify"
    },
    {
      "source": "/api/user-profile/sync-progress",
      "destination": "/api/user-profile?action=sync-progress"
    },
    {
      "source": "/api/colleges",
      "destination": "/api/college-quiz"
    },
    {
      "source": "/api/delete-quiz",
      "destination": "/api/college-quiz"
    },
    {
      "source": "/api/reports",
      "destination": "/api/college-quiz"
    },
    {
      "source": "/((?!api/|_vercel/|assets/|src/|favicon\\.|manifest\\.json|robots\\.txt|sitemap\\.xml|sitemap-static\\.xml|llms\\.txt|service-worker\\.js|about$|control$|create-quiz$|how-to-create-a-quiz$|how-to-upload-a-quiz$|how-to-use-ai-agent$|oauth-callback$|offline$|onboarding$|privacy-policy$|profile$|quiz$|reports$|result$|settings$|terms-of-service$|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/seo?type=cron",
      "schedule": "0 4 * * *"
    }
  ]
}