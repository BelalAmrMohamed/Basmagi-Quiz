{
  "buildCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/dist/chunks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/dist/(home|pages/[^/]+)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|svg|ico|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/src/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/sign-in.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/sign-in",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/log-in.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-dynamic.xml",
      "destination": "/api/seo?type=sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/seo?type=feed&format=rss"
    },
    {
      "source": "/feed.json",
      "destination": "/api/seo?type=feed&format=json"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/seo?type=llms-full"
    },
    {
      "source": "/:key([a-f0-9]{32}).txt",
      "destination": "/api/seo?type=indexnow-key&key=:key"
    },
    {
      "source": "/@:handle",
      "destination": "/api/render-profile?handle=:handle"
    },
    {
      "source": "/quiz/:id",
      "destination": "/api/render-quiz?id=:id"
    },
    {
      "source": "/q/:id",
      "destination": "/api/render-quiz?id=:id"
    },
    {
      "source": "/lesson/:id",
      "destination": "/api/render-course?contentType=lesson&id=:id"
    },
    {
      "source": "/notebook/new",
      "destination": "/notebook?mode=new"
    },
    {
      "source": "/notebook/edit/:id",
      "destination": "/notebook?mode=edit&id=:id"
    },
    {
      "source": "/notebook/:id",
      "destination": "/api/render-course?contentType=notebook&id=:id"
    },
    {
      "source": "/course/:full(.*)",
      "destination": "/api/render-course?full=:full"
    },
    {
      "source": "/api/admin-control",
      "destination": "/api/admin"
    },
    {
      "source": "/api/admin-stats",
      "destination": "/api/admin"
    },
    {
      "source": "/api/user-profile/identify",
      "destination": "/api/user-profile?action=identify"
    },
    {
      "source": "/api/user-profile/sync-progress",
      "destination": "/api/user-profile?action=sync-progress"
    },
    {
      "source": "/api/colleges",
      "destination": "/api/college-quiz"
    },
    {
      "source": "/api/delete-quiz",
      "destination": "/api/college-quiz"
    },
    {
      "source": "/api/reports",
      "destination": "/api/college-quiz"
    },
    {
      "source": "/api/mcp",
      "destination": "https://esdfdzhtavraczrhxnmp.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/api/mcp/(.*)",
      "destination": "https://esdfdzhtavraczrhxnmp.supabase.co/functions/v1/mcp/$1"
    },
    {
      "source": "/((?!api/|_vercel/|assets/|src/|favicon\\.|manifest\\.json|robots\\.txt|sitemap\\.xml|sitemap-static\\.xml|llms\\.txt|service-worker\\.js|about$|control$|create-quiz$|create-lesson$|notebook$|lesson-comments$|how-to-connect-mcp$|how-to-create-content$|how-to-upload-content$|how-to-use-ai-agent$|oauth-callback$|offline$|onboarding$|privacy-policy$|profile$|quiz$|reports$|result$|settings$|terms-of-service$|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/seo?type=cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin?cron=purge-drafts",
      "schedule": "30 4 * * *"
    }
  ]
}