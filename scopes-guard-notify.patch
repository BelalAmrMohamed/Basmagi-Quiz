-    if (!isPlainObject(activityHeatmap)) {
-      return res.status(400).json({ error: "Invalid activityHeatmap payload" });
-    }
-    for (const [key, value] of Object.entries(activityHeatmap)) {
-      if (
-        typeof key !== "string" ||
-        !/^\d{4}-\d{2}-\d{2}$/.test(key) ||
-        typeof value !== "number" ||
-        !Number.isFinite(value) ||
-        value < 0
