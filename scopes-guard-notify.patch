+    case "storage_warning":
+      return { ...base, tone: "danger" };
+
+    case "announcement":
+      return { ...base, tone: "admin" };
+
+    case "admin_request":
+      return {
+        ...base,
+        tone: "admin",
+        title: count > 1 ? `${fmt(count)} طلبات انضمام جديدة كمشرف` : "طلب انضمام جديد كمشرف",
+        body: count > 1 ? (m.name ? `آخرها: ${m.name}` : "") : n.body || m.name || "",
+        href: "/control",
+      };
+
+    default:
+      return base;
+  }
+}
