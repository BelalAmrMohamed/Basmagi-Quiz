+      Date.UTC(new Date().getUTCFullYear(), 0, 1) - 24 * 60 * 60 * 1000,
+    ).toISOString();
+
+    const [quizList, lessonList, notebookList, quizActivity, lessonActivity, notebookActivity] =
+      await Promise.all([
