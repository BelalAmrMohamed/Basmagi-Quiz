+ * @param {import('@supabase/supabase-js').SupabaseClient} supabase
+ * @param {{courseId?: string, folderId?: string}} scope - exactly one of these
+ * @returns {Promise<{folders: object[], quizzes: object[], lessons: object[], notebooks: object[]}>}
+ */
