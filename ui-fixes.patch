 /* ── Space reservation ──────────────────────────────────────────────────────
-   #offlineBanner is `position: fixed`, so by default it floats on top of the
-   page and permanently covers whatever sits at the bottom (e.g. a footer
-   with privacy/terms links), and the page can't scroll far enough to reveal
-   it. `--offline-banner-height` is kept up to date by offline-banner.js
-   (via getBoundingClientRect + a ResizeObserver) whenever the banner is
-   shown, and this padding pushes the rest of the page's content up above it.
+   The banner always sits at the very bottom of the viewport and everything
+   else moves up by its height: page content through body padding, and fixed
+   elements (which ignore that padding) through the rules below.
+   `--offline-banner-height` is kept up to date by offline-banner.js.
    ============================================================================ */
 body.has-offline-banner {
   padding-bottom: var(--offline-banner-height, 0px);
   transition: padding-bottom var(--transition-base, 0.3s ease);
 }
 
+/* Bottom-anchored elements: a margin lifts them without replacing their own
+   `bottom` offsets, which differ between breakpoints. */
+body.has-offline-banner :is(
+  .bottom-nav,
+  .ai-agent-fab,
+  #notification-container,
+  .bulk-action-bar,
+  .doc-toc-toggle,
+  .doc-toc,
+  .lesson-prefs__panel,
+  .lesson-bookmarks__panel,
+  .lesson-skeleton__toc-toggle
+) {
+  margin-bottom: var(--offline-banner-height, 0px);
+}
+
+/* The banner now covers the device's bottom safe area, not the nav bar. */
+body.has-offline-banner .bottom-nav {
+  height: var(--bottom-nav-height, 54px);
+  padding-bottom: 0;
+}
+
+/* Full-screen layers end where the banner starts. */
+body.has-offline-banner :is(
+  .side-menu-backdrop,
+  .modal-overlay,
+  .item-metadata-overlay,
+  .shortcuts-overlay,
+  .ai-agent-overlay,
+  .contact-overlay,
+  .yt-modal-overlay
+) {
+  bottom: var(--offline-banner-height, 0px);
+}
+
+body.has-offline-banner :is(.confirmation-overlay, .report-modal-overlay) {
+  height: calc(100vh - var(--offline-banner-height, 0px));
+  height: calc(100dvh - var(--offline-banner-height, 0px));
+}
+
+/* Side menu: full-height rail on desktop, bottom sheet on mobile. */
+@media (min-width: 769px) {
+  body.has-offline-banner .sidebar {
+    bottom: var(--offline-banner-height, 0px);
+    height: auto;
+  }
+}
+
+@media (max-width: 768px) {
+  body.has-offline-banner .sidebar {
+    margin-bottom: var(--offline-banner-height, 0px);
+  }
+
+  body.has-offline-banner .ai-agent-modal-card {
+    height: calc(100dvh - var(--offline-banner-height, 0px));
+  }
+}
