-.rmci-scroll { overflow-y: auto; padding: 14px 18px 2px; cursor: text; overscroll-behavior: contain; }
+/* Thin, transparent-track scrollbar so it never paints square corners. */
+.rmci-scroll {
+  overflow-y: auto; padding: 14px 18px 2px; cursor: text; overscroll-behavior: contain;
+  scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--rmci-muted) 45%, transparent) transparent;
+}
+/* The AI Agent input has a 24px radius: a full-bleed scroller let its scrollbar
+   poke past the rounded corners. Inset the scroller (top margin keeps the track
+   below the curve, side margin keeps it off the border) and move the padding
+   inside so the text stays where it was. */
+.ai-agent-chat-panel .rmci-scroll { margin: 14px 6px 0; padding: 2px 12px 2px; }
+.rmci-scroll::-webkit-scrollbar { width: 6px; }
+.rmci-scroll::-webkit-scrollbar-track { background: transparent; }
+.rmci-scroll::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--rmci-muted) 45%, transparent); border-radius: 3px; }
+.rmci-scroll::-webkit-scrollbar-thumb:hover { background: color-mix(in srgb, var(--rmci-muted) 65%, transparent); }
 .rmci-host { min-width: 0; }
 
