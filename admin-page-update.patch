+<!-- CRITICAL: Paints the nav avatar synchronously, right where the nav
+     markup ends, so it happens before the rest of the page below it is
+     parsed/painted. Uses window.__navAvatarDataUrl set in <head>.
+     Assigns `src` directly (no async decode-probe) so there is zero
+     delay before the first frame — an Image().onload probe would only
+     fire after this same event loop turn anyway, defeating the point.
+     If a data URL somehow fails to decode, the browser's own broken-
+     image behavior is a rare edge case (avatarEngine.js only ever
+     writes canvas-encoded JPEGs or well-formed generated SVGs), and
+     syncNavAvatars() from avatarEngine.js still runs shortly after via
+     side-menu.js and re-validates with its own decode-probe, correcting
+     course if needed. If window.__navAvatarDataUrl is unset (localStorage
+     failure), the default SVG icons already in the markup stay visible. -->
+<script>
+    (function () {
+        var dataUrl = window.__navAvatarDataUrl;
+        var targets = [
+            { imgId: "navSidebarAvatar", iconClass: "menu-item-default-icon" },
+            { imgId: "navBottomAvatar", iconClass: "bottom-nav-default-icon" },
+        ];
+
+        targets.forEach(function (t) {
+            var img = document.getElementById(t.imgId);
+            if (!img) return;
+            var parent = img.parentElement;
+
+            if (dataUrl) {
+                var icon = parent ? parent.querySelector("." + t.iconClass) : null;
+                img.src = dataUrl;
+                img.style.display = "";
+                if (icon) icon.style.display = "none";
+            }
+
+            // INSTANT BADGE INJECTION
+            try {
+                if (sessionStorage.getItem('__bq_adm') && parent && !parent.querySelector('.nav-badge-overlay')) {
+                    var p = JSON.parse(atob(sessionStorage.getItem('__bq_adm').split('.')[1]));
+                    var role = p.isOwner ? 'owner' : 'admin';
+                    // Anchor the badge to the avatar glyph rather than to
+                    // `parent`. For the bottom nav `parent` is the tight
+                    // .bottom-nav-icon box and is fine as-is; for the sidebar
+                    // it is the whole .menu-item ROW, so pinning the badge to
+                    // its corner parked it out in the row's padding, well clear
+                    // of the avatar. Mirrors resolveBadgeHost() in
+                    // navRoleBadge.js — inlined so the badge lands correctly on
+                    // the first paint, before any module has loaded.
+                    var glyph = parent.querySelector('.' + t.iconClass);
+                    var host = parent;
+                    if (parent.classList.contains('bottom-nav-icon')) {
+                        parent.style.position = 'relative';
+                    } else {
+                        host = document.createElement('span');
+                        host.className = 'nav-badge-anchor';
+                        parent.insertBefore(host, glyph || img);
+                        if (glyph) host.appendChild(glyph);
