diff -ruN a/public/src/shared/rich-input/code-block-view.js b/public/src/shared/rich-input/code-block-view.js
--- a/public/src/shared/rich-input/code-block-view.js	1970-01-01 00:00:00.000000000 +0000
+++ b/public/src/shared/rich-input/code-block-view.js	2026-11-15 18:16:44.201339641 +0000
@@ -0,0 +1,198 @@
+// =============================================================================
+// rich-input/code-block-view.js
+// Vanilla-DOM node view for code blocks: collapse/expand, a language menu and
+// a copy button above the (syntax-highlighted, editable) code. Port of the
+// 21st.dev component's React CodeBlockView.
+// =============================================================================
+import { icon } from "./icons.js";
+
+export const CODE_LANGUAGES = [
+  { label: "Plain text", value: "plaintext" },
+  { label: "JavaScript", value: "javascript" },
+  { label: "TypeScript", value: "typescript" },
+  { label: "Python", value: "python" },
+  { label: "HTML", value: "xml" },
+  { label: "CSS", value: "css" },
+  { label: "JSON", value: "json" },
+  { label: "Bash", value: "bash" },
+  { label: "C++", value: "cpp" },
+  { label: "Java", value: "java" },
+  { label: "C#", value: "csharp" },
+  { label: "SQL", value: "sql" },
+];
+
+const LANGUAGE_ALIASES = {
+  js: "javascript", jsx: "javascript", ts: "typescript", tsx: "typescript", py: "python",
+  html: "xml", sh: "bash", shell: "bash", zsh: "bash", text: "plaintext", txt: "plaintext",
+  "c++": "cpp", cc: "cpp", cxx: "cpp", "c#": "csharp", cs: "csharp",
+};
+
+const normalizeLanguage = (raw) => LANGUAGE_ALIASES[raw || "plaintext"] ?? (raw || "plaintext");
+
+/** Closes any open language menu (there is at most one at a time). */
+let closeOpenMenu = null;
+
+function openLanguageMenu(trigger, current, onPick) {
+  closeOpenMenu?.();
+  const host = document.body;
+  const r = trigger.getBoundingClientRect();
+  const menu = document.createElement("div");
+  menu.className = "rmci-menu rmci-lang-menu";
+  menu.setAttribute("role", "menu");
+  menu.dir = "ltr";
+  menu.style.position = "fixed";
+  menu.style.right = `${Math.max(8, window.innerWidth - r.right)}px`;
+  const below = window.innerHeight - r.bottom;
+  if (below < 290 && r.top > below) menu.style.bottom = `${window.innerHeight - r.top + 4}px`;
+  else menu.style.top = `${r.bottom + 4}px`;
+
+  CODE_LANGUAGES.forEach((l) => {
+    const item = document.createElement("button");
+    item.type = "button";
+    item.className = "rmci-menu-item rmci-menu-item--compact";
+    item.setAttribute("role", "menuitem");
+    item.innerHTML = `<span class="rmci-menu-label">${l.label}</span>${l.value === current ? icon("check", 14) : ""}`;
+    item.addEventListener("mousedown", (e) => e.preventDefault());
+    item.addEventListener("click", () => { onPick(l.value); close(); });
+    menu.appendChild(item);
+  });
+
+  const onDown = (e) => { if (!menu.contains(e.target) && !trigger.contains(e.target)) close(); };
+  const onKey = (e) => { if (e.key === "Escape") close(); };
+  // Scroll events are captured from everything, including the menu's own list;
+  // only close when something OUTSIDE the menu scrolls (page/chat behind it).
+  const onScroll = (e) => { if (menu.contains(e.target)) return; close(); };
+  function close() {
+    menu.remove();
+    trigger.setAttribute("aria-expanded", "false");
+    trigger.classList.remove("is-open");
+    document.removeEventListener("mousedown", onDown);
+    document.removeEventListener("keydown", onKey);
+    window.removeEventListener("resize", close);
+    window.removeEventListener("scroll", onScroll, true);
+    if (closeOpenMenu === close) closeOpenMenu = null;
+  }
+  document.addEventListener("mousedown", onDown);
+  document.addEventListener("keydown", onKey);
+  window.addEventListener("resize", close);
+  window.addEventListener("scroll", onScroll, true);
+  trigger.setAttribute("aria-expanded", "true");
+  trigger.classList.add("is-open");
+  host.appendChild(menu);
+  closeOpenMenu = close;
+}
+
+/**
+ * Tiptap `addNodeView` factory. Returns a ProseMirror NodeView.
+ * @param {{ node: any, editor: any, getPos: () => number }} props
+ */
+export function createCodeBlockView({ node: initialNode, editor, getPos }) {
+  let node = initialNode;
+  let copyTimer = 0;
+
+  const dom = document.createElement("div");
+  dom.className = "rmci-codeblock";
+  dom.dir = "ltr";
+
+  const header = document.createElement("div");
+  header.className = "rmci-codeblock-header";
+  header.contentEditable = "false";
+
+  const collapseBtn = document.createElement("button");
+  collapseBtn.type = "button";
+  collapseBtn.className = "rmci-codeblock-btn";
+  collapseBtn.addEventListener("mousedown", (e) => e.preventDefault());
+
+  const right = document.createElement("div");
+  right.className = "rmci-codeblock-actions";
+
+  const langBtn = document.createElement("button");
+  langBtn.type = "button";
+  langBtn.className = "rmci-lang-btn";
+  langBtn.setAttribute("aria-haspopup", "menu");
+  langBtn.setAttribute("aria-expanded", "false");
+  langBtn.setAttribute("aria-label", "Code language");
+  langBtn.addEventListener("mousedown", (e) => e.preventDefault());
+
+  const copyBtn = document.createElement("button");
+  copyBtn.type = "button";
+  copyBtn.className = "rmci-codeblock-btn";
+  copyBtn.setAttribute("aria-label", "Copy code");
+  copyBtn.addEventListener("mousedown", (e) => e.preventDefault());
+
+  right.append(langBtn, copyBtn);
+  header.append(collapseBtn, right);
+
+  const pre = document.createElement("pre");
+  pre.className = "rmci-codeblock-pre";
+  const code = document.createElement("code");
+  pre.appendChild(code);
+
+  const fade = document.createElement("div");
+  fade.className = "rmci-codeblock-fade";
+  fade.contentEditable = "false";
+
+  dom.append(header, pre, fade);
+
+  function updateAttributes(attrs) {
+    const pos = getPos();
+    if (typeof pos !== "number") return;
+    editor.view.dispatch(editor.view.state.tr.setNodeMarkup(pos, undefined, { ...node.attrs, ...attrs }));
+  }
+
+  function render() {
+    const language = normalizeLanguage(node.attrs.language);
+    const collapsed = !!node.attrs.collapsed;
+    const label = CODE_LANGUAGES.find((l) => l.value === language)?.label ?? language;
+    code.className = `hljs language-${language}`;
+    pre.dataset.collapsed = String(collapsed);
+    pre.classList.toggle("is-collapsed", collapsed);
+    fade.hidden = !collapsed;
+    collapseBtn.setAttribute("aria-label", collapsed ? "Expand code block" : "Collapse code block");
+    collapseBtn.setAttribute("aria-expanded", String(!collapsed));
+    collapseBtn.innerHTML = `${icon(collapsed ? "expand" : "collapse", 14)}${collapsed ? "Expand" : "Collapse"}`;
+    langBtn.innerHTML = `${label}${icon("chevronDown", 12)}`;
+    if (!copyTimer) copyBtn.innerHTML = `${icon("copy", 14)}Copy`;
+  }
+
+  collapseBtn.addEventListener("click", () => updateAttributes({ collapsed: !node.attrs.collapsed }));
+  langBtn.addEventListener("click", () => {
+    if (langBtn.classList.contains("is-open")) return closeOpenMenu?.();
+    openLanguageMenu(langBtn, normalizeLanguage(node.attrs.language), (v) => updateAttributes({ language: v }));
+  });
+  copyBtn.addEventListener("click", async () => {
+    try {
+      await navigator.clipboard.writeText(node.textContent);
+      copyBtn.innerHTML = `${icon("check", 14)}Copied`;
+      copyBtn.classList.add("is-done");
+      clearTimeout(copyTimer);
+      copyTimer = setTimeout(() => {
+        copyTimer = 0;
+        copyBtn.classList.remove("is-done");
+        copyBtn.innerHTML = `${icon("copy", 14)}Copy`;
+      }, 2000);
+    } catch {
+      /* clipboard unavailable */
+    }
+  });
+
+  render();
+
+  return {
+    dom,
+    contentDOM: code,
+    update(updated) {
+      if (updated.type !== node.type) return false;
+      node = updated;
+      render();
+      return true;
+    },
+    // Header/fade are chrome: ProseMirror must not treat their changes as edits
+    // or let their clicks move the selection.
+    ignoreMutation: (m) => m.type !== "selection" && !code.contains(m.target) && m.target !== code,
+    stopEvent: (e) => header.contains(e.target),
+    destroy() {
+      clearTimeout(copyTimer);
+    },
+  };
+}
diff -ruN a/public/src/shared/rich-input/dictation.js b/public/src/shared/rich-input/dictation.js
--- a/public/src/shared/rich-input/dictation.js	1970-01-01 00:00:00.000000000 +0000
+++ b/public/src/shared/rich-input/dictation.js	2026-11-15 18:18:27.270720047 +0000
@@ -0,0 +1,102 @@
+// =============================================================================
+// rich-input/dictation.js
+// Voice dictation (Web Speech API) for a rich input: adds a mic button to its
+// bottom bar and live-transcribes into it, appended after what is already
+// typed. Framework-free; the button is only added when the browser supports
+// SpeechRecognition. (The AI Agent chat keeps its own richer mic UI with the
+// volume wave; this is the lightweight shared version.)
+// =============================================================================
+const MIC = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><line x1="12" x2="12" y1="19" y2="22"/></svg>';
+const STOP = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';
+
+/**
+ * @param {{ endSlot: HTMLElement, host: HTMLElement & { value: string }, focus: Function }} rich createRichInput() result
+ * @param {{ onError?: (message: string) => void }} [options]
+ * @returns {{ stop: () => void, supported: boolean } }
+ */
+export function attachDictation(rich, { onError } = {}) {
+  const Ctor = window.SpeechRecognition || window.webkitSpeechRecognition || null;
+  if (!Ctor) return { stop() {}, supported: false };
+
+  const btn = document.createElement("button");
+  btn.type = "button";
+  btn.className = "rmci-icon-btn rmci-mic-btn";
+  rich.endSlot.appendChild(btn);
+
+  let recognition = null;
+  let listening = false;
+  let finalized = "";
+  let base = "";
+  let retried = false;
+
+  const paint = () => {
+    btn.innerHTML = listening ? STOP : MIC;
+    btn.classList.toggle("is-listening", listening);
+    btn.setAttribute("aria-pressed", String(listening));
+    const label = listening ? "إيقاف الإملاء الصوتي" : "إملاء صوتي";
+    btn.title = label;
+    btn.setAttribute("aria-label", label);
+  };
+  const compose = (interim) => {
+    const spoken = [finalized.trim(), (interim || "").trim()].filter(Boolean).join(" ");
+    return [base.trim(), spoken].filter(Boolean).join(base.trim() ? " " : "");
+  };
+  const finish = () => { listening = false; paint(); };
+  const stop = () => {
+    const r = recognition;
+    recognition = null;
+    try { r?.stop(); } catch { /* already stopped */ }
+    finish();
+  };
+
+  function start(isRetry = false) {
+    if (listening || rich.host.disabled) return;
+    finalized = "";
+    base = rich.host.value;
+    if (!isRetry) retried = false;
+    const session = new Ctor();
+    recognition = session;
+    session.lang = document.documentElement?.lang === "en" ? "en-US" : "ar-EG";
+    session.continuous = true;
+    session.interimResults = true;
+    session.onresult = (e) => {
+      let interim = "";
+      for (let i = e.resultIndex; i < e.results.length; i++) {
+        if (e.results[i].isFinal) finalized = `${finalized} ${e.results[i][0].transcript}`.trim();
+        else interim += e.results[i][0].transcript;
+      }
+      const next = compose(interim);
+      rich.host.value = next;
+      // Programmatic value changes are silent (like a textarea), so tell listeners.
+      rich.host.dispatchEvent(new Event("input", { bubbles: true }));
+    };
+    session.onerror = (e) => {
+      if (recognition !== session) return;
+      if (e.error === "no-speech" || e.error === "aborted") return finish();
+      if (e.error === "network" && !retried) {
+        retried = true;
+        finish();
+        try { start(true); } catch { /* reported below on next attempt */ }
+        return;
+      }
+      finish();
+      onError?.(e.error === "network"
+        ? "تعذر الوصول إلى خدمة التعرف الصوتي. تحقق من الاتصال أو اكتب إجابتك."
+        : "تعذر استخدام الإملاء الصوتي. حاول مرة أخرى.");
+    };
+    session.onend = () => { if (recognition === session) finish(); };
+    try {
+      session.start();
+      listening = true;
+      paint();
+    } catch (err) {
+      console.error("[rich-input] dictation start failed:", err);
+      onError?.("تعذر بدء الإملاء الصوتي.");
+    }
+  }
+
+  btn.addEventListener("mousedown", (e) => e.preventDefault());
+  btn.addEventListener("click", () => { if (listening) { stop(); rich.focus("end"); } else start(); });
+  paint();
+  return { stop, supported: true };
+}
diff -ruN a/public/src/shared/rich-input/essay-field.js b/public/src/shared/rich-input/essay-field.js
--- a/public/src/shared/rich-input/essay-field.js	1970-01-01 00:00:00.000000000 +0000
+++ b/public/src/shared/rich-input/essay-field.js	2026-11-15 18:19:19.278022445 +0000
@@ -0,0 +1,47 @@
+// =============================================================================
+// rich-input/essay-field.js
+// Turns essay answer <textarea data-essay-field> elements (quiz + lesson pages)
+// into the shared rich markdown input, with voice dictation.
+//
+//   markup:  <textarea data-essay-field id=".." class=".." placeholder="..">saved markdown</textarea>
+//   after inserting the markup:  mountEssayFields(containerElement)
+//
+// The textarea is replaced by the rich input's host element, which keeps the
+// textarea's id and classes and the same members the pages already use:
+//   host.value      plain text (use for "is it empty?")
+//   host.markdown   the answer as markdown  <- store / grade this
+//   host.disabled   lock it: stays rendered, read-only, toolbar + mic hidden
+//   "input" event   fired on every user edit
+// Calling mountEssayFields again is safe (already-mounted fields are skipped,
+// and editors whose DOM was thrown away by a re-render are destroyed).
+// =============================================================================
+import { createRichInput } from "./rich-input.js";
+import { attachDictation } from "./dictation.js";
+
+const live = new Set();
+
+export function mountEssayFields(root = document, { onError } = {}) {
+  for (const inst of live) {
+    if (!inst.el.isConnected) { inst.destroy(); live.delete(inst); }
+  }
+  root.querySelectorAll("textarea[data-essay-field]").forEach((ta) => {
+    const rich = createRichInput({
+      placeholder: ta.getAttribute("placeholder") || "",
+      direction: "auto",
+      maxHeight: 360,
+      initialMarkdown: ta.value,
+      hideControlsWhenDisabled: true,
+    });
+    const host = rich.host;
+    host.id = ta.id;
+    host.className += ` ${ta.className}`;
+    const inline = ta.getAttribute("oninput");
+    if (inline) host.setAttribute("oninput", inline); // legacy inline handler keeps working
+    rich.el.classList.add("rmci-root--essay");
+    attachDictation(rich, { onError });
+    const disabled = ta.disabled;
+    ta.replaceWith(rich.el);
+    host.disabled = disabled;
+    live.add(rich);
+  });
+}
diff -ruN a/public/src/shared/rich-input/extensions.js b/public/src/shared/rich-input/extensions.js
--- a/public/src/shared/rich-input/extensions.js	1970-01-01 00:00:00.000000000 +0000
+++ b/public/src/shared/rich-input/extensions.js	2026-11-15 18:16:44.201358737 +0000
@@ -0,0 +1,223 @@
+// =============================================================================
+// rich-input/extensions.js
+// Builds the Tiptap extension list. Takes the lazily-loaded vendor module `T`
+// (public/assets/vendor/tiptap/tiptap.js) so nothing here imports Tiptap at
+// module-evaluation time.
+//
+// Same behaviour as the 21st.dev component:
+//   Enter            new line / block (send is handled by the chat panel)
+//   Shift+Enter      soft break (plain newline inside code blocks)
+//   Ctrl/Cmd+Enter   send
+//   ```lang + Enter  turns the line into a code block; a lone ``` + Enter on
+//                    the last line of a code block closes it
+// plus per-block bidi (Arabic/English blocks align on their own) and command /
+// @mention highlighting (replaces the old textarea mirror).
+// =============================================================================
+import { createCodeBlockView } from "./code-block-view.js";
+
+const commandName = (c) => String(c?.command ?? "").trim().replace(/^\//, "");
+const mentionName = (m) => String(m?.name ?? m?.token ?? "").trim().replace(/^@/, "");
+
+export function buildExtensions(T, options) {
+  const { placeholder, direction, onSubmit, getCommands, getMentions } = options;
+  const lowlight = T.createLowlight(T.common);
+
+  // `<u>text</u>` -> underline
+  const UnderlineMd = T.Underline.extend({
+    addInputRules() {
+      return [T.markInputRule({ find: /(?:<u>)([^<]+)(?:<\/u>)$/, type: this.type })];
+    },
+  });
+
+  const CodeBlock = T.CodeBlockLowlight.extend({
+    addAttributes() {
+      return {
+        ...this.parent?.(),
+        collapsed: { default: false, rendered: false, keepOnSplit: false },
+      };
+    },
+    addNodeView() {
+      return (props) => createCodeBlockView(props);
+    },
+  }).configure({ lowlight, defaultLanguage: "plaintext" });
+
+  // Per-block bidi: paragraphs and headings get dir="auto".
+  const BidiBlocks = T.Extension.create({
+    name: "bidiBlocks",
+    addGlobalAttributes() {
+      const auto = direction === "auto";
+      return [
+        {
+          types: ["paragraph", "heading"],
+          attributes: {
+            dir: {
+              default: auto ? "auto" : null,
+              parseHTML: (el) => el.getAttribute("dir") || (auto ? "auto" : null),
+              renderHTML: (attrs) => (attrs.dir ? { dir: attrs.dir } : {}),
+            },
+          },
+        },
+      ];
+    },
+  });
+
+  const ChatShortcuts = T.Extension.create({
+    name: "chatShortcuts",
+    priority: 1000,
+    addKeyboardShortcuts() {
+      return {
+        "Mod-Enter": () => onSubmit(),
+        "Shift-Enter": ({ editor }) => (editor.isActive("codeBlock") ? editor.commands.newlineInCode() : false),
+        Enter: ({ editor }) => {
+          const { $from, empty } = editor.state.selection;
+          const parent = $from.parent;
+          const atEnd = empty && $from.parentOffset === parent.content.size;
+
+          if (atEnd && parent.type.name === "codeBlock") {
+            const m = /(^|\n)```$/.exec(parent.textContent);
+            if (m) {
+              return editor.chain().focus()
+                .deleteRange({ from: $from.pos - m[0].length, to: $from.pos })
+                .exitCode()
+                .run();
+            }
+          }
+
+          if (atEnd && parent.type.name === "paragraph") {
+            const f = /^```([\w+#.-]*)$/.exec(parent.textContent);
+            if (f) {
+              return editor.chain().focus()
+                .deleteRange({ from: $from.start(), to: $from.end() })
+                .setCodeBlock(f[1] ? { language: f[1] } : undefined)
+                .run();
+            }
+          }
+          return false;
+        },
+      };
+    },
+  });
+
+  // Highlights `/command` (only as the first word) and known `@mention` tokens.
+  //
+  // Robustness notes (the chips used to end up half-painted, e.g. "/expla" + "i"
+  // + "n" while typing): (1) decorations are computed in one pure function that
+  // can never throw into ProseMirror's update cycle — a throw there aborts the
+  // view update and leaves stale chip <span>s with natively-typed text next to
+  // them; (2) invisible bidi/zero-width marks that RTL keyboards insert next to
+  // a word are ignored when matching, so "/ex\u200Fplain" still counts as
+  // /explain; (3) a self-heal pass compares the painted chips with the expected
+  // ones after every update and, on any drift, rebuilds the DOM once.
+  const INVISIBLE = /[\u200B-\u200F\u202A-\u202E\u2060-\u2069\uFEFF]/g;
+  const WORD_START = "(^|[\\s\\u00A0\\u200B-\\u200F\\u202A-\\u202E\\u2066-\\u2069])";
+
+  function computeTokens(doc) {
+    const out = []; // { from, to, kind }
+    let commands, mentions;
+    try {
+      commands = new Set((getCommands?.() || []).map((c) => commandName(c).toLowerCase()).filter(Boolean));
+      mentions = new Set((getMentions?.() || []).map((m) => mentionName(m).toLowerCase()).filter(Boolean));
+    } catch {
+      return out;
+    }
+    if (!commands.size && !mentions.size) return out;
+    doc.descendants((node, pos) => {
+      if (node.type.name === "codeBlock") return false;
+      if (!node.isTextblock) return true;
+      // textBetween with a 1-char leaf placeholder keeps string offsets identical
+      // to document positions. `node.textContent` drops soft line breaks
+      // (Shift+Enter), which shifted every chip after the first break.
+      const text = node.textBetween(0, node.content.size, "", "\n");
+      const start = pos + 1;
+      const scan = (re, set, kind) => {
+        re.lastIndex = 0;
+        let m;
+        while ((m = re.exec(text))) {
+          const word = m[2].replace(INVISIBLE, "").toLowerCase();
+          if (set.has(word)) {
+            const from = start + m.index + m[1].length;
+            out.push({ from, to: from + m[2].length + 1, kind });
+          }
+        }
+      };
+      if (commands.size) scan(new RegExp(`${WORD_START}/([^\\s/]+)`, "g"), commands, "command");
+      if (mentions.size) scan(new RegExp(`${WORD_START}@([^\\s@]+)`, "g"), mentions, "mention");
+      return false;
+    });
+    return out;
+  }
+
+  const TokenHighlight = T.Extension.create({
+    name: "tokenHighlight",
+    addProseMirrorPlugins() {
+      const key = new T.PluginKey("rmciTokens");
+      return [
+        new T.Plugin({
+          key,
+          // `bust` is flipped on for exactly one transaction by the self-heal
+          // below: painting nothing for a beat forces ProseMirror to rebuild
+          // the paragraph DOM, then the next transaction paints correctly.
+          state: {
+            init: () => ({ bust: false }),
+            apply: (tr, prev) => {
+              const meta = tr.getMeta(key);
+              return meta ? { bust: !!meta.bust } : prev;
+            },
+          },
+          props: {
+            decorations(state) {
+              if (key.getState(state)?.bust) return T.DecorationSet.empty;
+              try {
+                const decos = computeTokens(state.doc).map((t) =>
+                  T.Decoration.inline(t.from, t.to, { class: `rmci-token rmci-token--${t.kind}` }, { inclusiveStart: false, inclusiveEnd: false }),
+                );
+                return decos.length ? T.DecorationSet.create(state.doc, decos) : T.DecorationSet.empty;
+              } catch {
+                return T.DecorationSet.empty;
+              }
+            },
+          },
+          view() {
+            let raf = 0;
+            let bustedDoc = null;
+            return {
+              update(view) {
+                if (key.getState(view.state)?.bust) {
+                  // Paint again on the next frame (outside this update cycle).
+                  cancelAnimationFrame(raf);
+                  raf = requestAnimationFrame(() => view.dispatch(view.state.tr.setMeta(key, { bust: false })));
+                  return;
+                }
+                cancelAnimationFrame(raf);
+                raf = requestAnimationFrame(() => {
+                  if (view.isDestroyed || view.composing) return;
+                  const doc = view.state.doc;
+                  if (doc === bustedDoc) return; // already rebuilt for this doc — never loop
+                  const want = computeTokens(doc).map((t) => doc.textBetween(t.from, t.to)).join("|");
+                  const got = [...view.dom.querySelectorAll(".rmci-token")].map((el) => el.textContent).join("|");
+                  if (want !== got) {
+                    bustedDoc = doc;
+                    view.dispatch(view.state.tr.setMeta(key, { bust: true }));
+                  }
+                });
+              },
+              destroy() { cancelAnimationFrame(raf); },
+            };
+          },
+        }),
+      ];
+    },
+  });
+
+  return [
+    // TipTap v3's StarterKit already bundles Underline; ours (with the <u> input rule) replaces it.
+    T.StarterKit.configure({ codeBlock: false, underline: false, heading: { levels: [1, 2, 3] } }),
+    UnderlineMd,
+    T.Typography,
+    T.Placeholder.configure({ placeholder }),
+    CodeBlock,
+    BidiBlocks,
+    ChatShortcuts,
+    TokenHighlight,
+  ];
+}
