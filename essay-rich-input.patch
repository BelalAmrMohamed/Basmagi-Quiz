+  if (locked) {
+    leading = `<span class="rmci-menu-lock">${icon("lock", 15)}</span>`;
+  } else if (leadingCheck) {
+    if (selected) {
+      leading = `<span class="rmci-menu-check">${icon("check", 16)}</span>`;
+    } else {
+      leading = `<span class="rmci-menu-spacer" aria-hidden="true"></span>`;
+    }
