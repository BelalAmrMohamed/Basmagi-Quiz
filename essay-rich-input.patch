+  // ── Formatting toolbar ───────────────────────────────────────────────────
+  const TOOLBAR_BUTTONS = [
+    { id: "bold", icon: "bold", label: "عريض (Ctrl+B)", active: (e) => e.isActive("bold"), run: (c) => c.toggleBold() },
+    { id: "italic", icon: "italic", label: "مائل (Ctrl+I)", active: (e) => e.isActive("italic"), run: (c) => c.toggleItalic() },
