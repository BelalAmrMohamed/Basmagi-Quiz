+// ── Rich Input migration: replace .md-source textareas with Tiptap editors ──
+// Mirrors the MutationObserver pattern that observeRichInputHighlighters used,
+// but creates Rich Input instances instead of syntax-highlight mirrors.
+// The same `id` is transferred to the host div so all existing id-based lookups
+// (activateMdEditor, preview panes, label[for=...]) keep working.
+(function observeAndUpgradeMdSources() {
+  const richInstances = new Map(); // hostEl → richInstance
+
+  function upgrade(textarea) {
+    if (!(textarea instanceof HTMLTextAreaElement)) return;
+    if (textarea.dataset.richUpgraded) return;
+    if (!textarea.parentElement) return;
+    textarea.dataset.richUpgraded = "1";
+
+    const originalId = textarea.id;
+    const originalValue = textarea.value;
+    const originalPlaceholder = textarea.placeholder;
+
+    const rich = createRichInput({
+      initialMarkdown: originalValue,
+      placeholder: originalPlaceholder,
+      direction: textarea.dir || "auto",
+    });
+
+    // Transfer the id to the host so label[for] / getElementById still work.
+    if (originalId) {
+      textarea.removeAttribute("id");
+      rich.host.id = originalId;
+    }
+    // Keep class list compatible with global toolbar tracking.
+    rich.host.classList.add("md-source", "rmci-host");
+    if (textarea.classList.contains("wp-textarea")) rich.host.classList.add("wp-textarea");
+
+    textarea.replaceWith(rich.el);
+    richInstances.set(rich.host, rich);
+  }
+
+  function sweepRemoved() {
+    for (const [host, rich] of richInstances) {
+      if (!host.isConnected) {
+        rich.destroy();
+        richInstances.delete(host);
+      }
+    }
+  }
+
+  const observer = new MutationObserver((records) => {
+    let removed = false;
+    for (const record of records) {
+      if (record.removedNodes.length) removed = true;
+      for (const node of record.addedNodes) {
+        if (node.nodeType !== Node.ELEMENT_NODE) continue;
+        if (node.matches?.(".md-source")) upgrade(node);
+        for (const ta of node.querySelectorAll?.(".md-source") ?? []) upgrade(ta);
+      }
+    }
+    if (removed && richInstances.size) sweepRemoved();
+  });
+  observer.observe(document.body, { childList: true, subtree: true });
+  for (const ta of document.querySelectorAll(".md-source")) upgrade(ta);
+}());
 
