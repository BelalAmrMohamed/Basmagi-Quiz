+      const hasResponse = isEssayQuestion(q)
+        ? typeof ans === "string" && ans.trim() !== ""
+        : ans !== null && ans !== undefined && (!Array.isArray(ans) || ans.length > 0);
+      btn.disabled = !hasResponse;
+    },
