+    font-size: 13px;
+    font-weight: 600;
+  }
+
+  .quiz-timer {
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    font-variant-numeric: tabular-nums;
+  }
+
+  .progress-container {
+    background: rgba(255, 255, 255, 0.2);
