+  }
+
+  .question-card:last-child {
+    margin-bottom: 0;
+  }
+
+  .question-card:hover {
+    box-shadow: var(--shadow-md);
+    
+  }
+
+  .question-card.answered {
+    border-color: var(--gradient-start);
