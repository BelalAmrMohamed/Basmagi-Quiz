+  }
+
+  /* \u2500\u2500 Reading Passage \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */
+  .reading-passage {
+    max-height: min(420px, 55vh);
+    overflow-y: auto;
+    padding: 20px 24px;
+    border-radius: 12px;
+    border: 1px solid var(--color-border);
